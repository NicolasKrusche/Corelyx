{
  "name": "@flowos/connector-kit",
  "version": "0.1.0",
  "description": "SDK for building custom Corelyx connectors with Zod schemas, typed operations, and auth helpers",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "corelyx-connector": "./cli/index.ts"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schemas": {
      "default": "./src/schemas.ts"
    },
    "./auth": {
      "default": "./src/auth.ts"
    },
    "./manifest": {
      "default": "./src/manifest.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "files": [
    "src",
    "cli"
  ],
  "license": "MIT"
}
