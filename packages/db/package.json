{
  "name": "@flowos/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "gen:types": "supabase gen types typescript --local > src/database.types.ts",
    "gen:types:rest": "node scripts/generate-rest-types.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
