# Corelyx pnpm security hardening (Task #2: Semgrep SAST Pipeline Fix, Score 9.0)
# See evaluated-2026-07-19.md Action Plan #2, Schritt 2

# Block installation of exotic/non-registry subdependencies (typosquat / hijack defense)
block-exotic-subdeps=true

# Require packages to be published at least 7 days ago before install (supply-chain cooldown)
minimum-release-age=10080

# Prevent downgrade attacks: refuse to install a version older than what is locked
trust-policy=no-downgrade

# Pin the pnpm version used (matches CI: pnpm/action-setup@v4 version 9.15.9)
package-manager-strict=true
