# ═══════════════════════════════════════════════════════════════════════════════
# Corelyx — Self-Hosted Environment Configuration
# Copy this file to .env and fill in the values before starting.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────────────────
# Public URL of the web application (used for CORS, links, callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
# Self-hosted uses a local Postgres; these point to it directly.
# In production with Supabase, use the Supabase dashboard values instead.
DATABASE_URL=postgresql://corelyx:changeme@postgres:5432/corelyx
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.local-service-role-key

# ─── Runtime Service ──────────────────────────────────────────────────────────
NEXT_PUBLIC_RUNTIME_URL=http://localhost:8002
RUNTIME_URL=http://runtime:8002
RUNTIME_INTERNAL_URL=http://runtime:8002

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── LLM API Keys (BYOK — Bring Your Own Key) ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Set to "true" ONLY if OPENAI_API_KEY belongs to a verified EU-resident OpenAI
# account and you require EU data residency.
OPENAI_EU_RESIDENCY=false
LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=

# ─── Anthropic OAuth (optional — for OAuth flow) ──────────────────────────────
ANTHROPIC_CLIENT_ID=
ANTHROPIC_CLIENT_SECRET=

# ─── Inngest (background jobs & triggers) ─────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Fallback signing key for zero-downtime key rotation
INNGEST_SIGNING_KEY_FALLBACK=

# ─── Sentry (optional — error tracking + performance) ─────────────────────────
# Public DSN used by the browser (client) Sentry SDK.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE=0.1
# Server-side DSN used by Next.js server/edge runtimes and the Python runtime.
# Usually the same project DSN as the public one; kept server-only so it is not
# shipped to the browser bundle. Leave blank to disable Sentry entirely.
SENTRY_DSN=

# ─── Structured logging ───────────────────────────────────────────────────────
# pino (web) / structlog (runtime) log level: trace|debug|info|warn|error
LOG_LEVEL=info

# ─── Turnstile (optional — bot protection) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Internal Service Auth ────────────────────────────────────────────────────
# Shared secret for web↔runtime authentication
INTERNAL_SERVICE_AUTH_SECRET_WEB_TO_RUNTIME=change-me-web-to-runtime
INTERNAL_SERVICE_AUTH_SECRET_RUNTIME_TO_WEB=change-me-runtime-to-web

# ─── PostgreSQL (for docker-compose postgres init) ─────────────────────────────
POSTGRES_DB=corelyx
POSTGRES_USER=corelyx
POSTGRES_PASSWORD=changeme
