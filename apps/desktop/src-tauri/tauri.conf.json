{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corelyx Desktop",
  "version": "0.1.1",
  "identifier": "app.corelyx.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Corelyx",
        "url": "https://corelyx.app",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Run Corelyx workflows on your local files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://corelyx.app/api/desktop/update"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0RjFFQkZERkNGQUE0NDAKUldSQXBQcjgvZXZ4VkRVbDlkeGdZa0trUHZxOWRTNDNJWExkbjNYRW9MRlBHOVk4RFQ0ZHpPRWEK"
    }
  }
}
