# Runtime service
RUNTIME_ENV=local
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=8002
EXECUTION_LOG_VERBOSITY=METADATA_ONLY

# Supabase service-role access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared internal authentication
RUNTIME_SECRET=
INTERNAL_SERVICE_AUTH_SECRET=
INTERNAL_SERVICE_AUTH_SECRET_RUNTIME_EXECUTE=
INTERNAL_SERVICE_AUTH_SECRET_NEXT_RUNS_COMPLETE=
INTERNAL_SERVICE_AUTH_SECRET_NEXT_CONNECTIONS_TOKEN=
INTERNAL_SERVICE_AUTH_SECRET_NEXT_VAULT=
INTERNAL_SERVICE_AUTH_SECRET_NEXT_EVENT_DISPATCH=

# Web app callbacks
NEXTJS_INTERNAL_URL=http://localhost:3000
CORS_ORIGINS=https://corelyx.app,https://www.corelyx.app,http://localhost:3000
RUNTIME_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional model/provider keys used by runtime connectors
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=

# Strict PII tier — local person-name detection (Phase 2 pseudonymization).
# Backend: auto (default; tries gliner then spacy), gliner, spacy, or off.
# Requires the optional dependency to be installed (see requirements.txt).
PII_NER_BACKEND=auto
# Optional model override (gliner default: urchade/gliner_multi_pii-v1,
# spacy default: xx_ent_wiki_sm)
PII_NER_MODEL=
