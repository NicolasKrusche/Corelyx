# Core application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_ENV=local
VERCEL_ENV=
NEXT_PUBLIC_ALLOW_MOCK_USER=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REGION=

# Admin access
# Comma-separated emails allowed into /admin in addition to profiles.is_admin.
ADMIN_EMAILS=

# Email two-factor authentication: signs the browser verification cookie.
# Falls back to INTERNAL_SERVICE_AUTH_SECRET when unset.
TWO_FACTOR_COOKIE_SECRET=

# Cloudflare Turnstile signup CAPTCHA. Both unset = feature off (no widget,
# no server check). Get keys at dash.cloudflare.com -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Set to "true" ONLY if OPENAI_API_KEY belongs to a verified EU-resident OpenAI
# project; allows eu_only workspaces to use semantic knowledge embeddings.
OPENAI_EU_RESIDENCY=
LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=
# Platform key used when users pay with credits (Genesis + workflow execution)
PLATFORM_OPENROUTER_API_KEY=

# Runtime and internal service authentication
NEXT_PUBLIC_RUNTIME_URL=http://localhost:8002
RUNTIME_URL=$NEXT_PUBLIC_RUNTIME_URL
RUNTIME_INTERNAL_URL=$NEXT_PUBLIC_RUNTIME_URL
RUNTIME_SECRET=
INTERNAL_SERVICE_AUTH_SECRET=
INTERNAL_SERVICE_AUTH_SECRET_RUNTIME_EXECUTE=
INTERNAL_SERVICE_AUTH_SECRET_RUNTIME_INTROSPECT=
INTERNAL_SERVICE_AUTH_SECRET_NEXT_RUNS_COMPLETE=
INTERNAL_SERVICE_AUTH_SECRET_NEXT_CONNECTIONS_TOKEN=
INTERNAL_SERVICE_AUTH_SECRET_NEXT_VAULT=
# Cron heartbeat (runtime → web every 60s; fires due cron triggers).
# Must be set to the SAME value in Vercel and Railway.
INTERNAL_SERVICE_AUTH_SECRET_NEXT_CRON_TICK=
OAUTH_STATE_SECRET=
WEBHOOK_SIGNING_SECRET=
# Dedicated key for signing the email-2FA trusted-browser cookie. Set this in
# production to keep the 2FA cookie key separate from the internal service key.
TWO_FACTOR_COOKIE_SECRET=

# Inngest
# Cron triggers + other scheduled functions are invoked by the Inngest platform,
# not by `next dev`. Locally you must run the dev server alongside the app:
#   pnpm --filter @flowos/web dev:inngest   (dashboard: http://localhost:8288)
# In production INNGEST_SIGNING_KEY is required (the /api/inngest route returns
# 503 without it) and the deployed app must be synced in the Inngest Cloud UI.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SIGNING_KEY_FALLBACK=

# Execution retention
EXECUTION_PAYLOAD_RETENTION_DAYS=30
EXECUTION_RUN_RETENTION_DAYS=90
RETENTION_AUDIT_RETENTION_DAYS=365

# Feature flags and emergency controls
DISABLE_GENESIS_GENERATION=
DISABLE_WORKFLOW_EXECUTION=
EMERGENCY_MAINTENANCE_MODE=
MAINTENANCE_MESSAGE=
# Break-glass fallback for the tester preview bypass (full maintenance mode).
# Primary path is the Emergency Controls admin page, which stores only a hash in
# the DB and needs no redeploy. Set this only as a DB-down fallback: a raw token
# (min 24 chars) usable via /?preview=<token>. Leave blank to disable. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAINTENANCE_BYPASS_TOKEN=
GLOBAL_BANNER_MESSAGE=
GLOBAL_BANNER_TYPE=
ENABLE_ADVANCED_EDITOR=
ENABLE_BULK_OPERATIONS=
ENABLE_GENESIS_V2=
ENABLE_NEW_CONNECTORS=
DAILY_RUN_QUOTA_PER_USER=
MAX_CONCURRENT_RUNS_PER_USER=

# Email and notifications
RESEND_API_KEY=
FROM_EMAIL=
RESEND_AUDIENCE_ID=
LEGAL_NOTIFY_EMAIL=
SECURITY_EMAIL=
SECURITY_ALERT_EMAIL=
FEEDBACK_NOTIFY_EMAIL=

# Public legal identity shown on legal pages
LEGAL_ENTITY_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS_LINE_1=
LEGAL_ADDRESS_LINE_2=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=
LEGAL_EMAIL=
PRIVACY_EMAIL=
LEGAL_VAT_ID=
LEGAL_COMPANY_REGISTER_NO=
LEGAL_COMMERCIAL_COURT=

# Translation
DEEPL_API_KEY=
DEEPL_PRO=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WELCOME_COUPON_ID=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUILDER_MONTHLY=
STRIPE_PRICE_BUILDER_YEARLY=

# Provider webhooks and watches
# IMPORTANT: webhook senders (Google Pub/Sub for Gmail, Google Drive for Sheets,
# GitHub) do NOT follow HTTP redirects. Register/point every webhook at the
# CANONICAL host with no trailing slash — e.g. https://www.corelyx.app/api/webhooks/gmail,
# never the apex https://corelyx.app/... which 308-redirects to www and makes the
# sender retry forever. Override the canonical host per-env with CANONICAL_WEBHOOK_HOST.
CANONICAL_WEBHOOK_HOST=
AIRTABLE_WEBHOOK_MAC_SECRET=
GITHUB_WEBHOOK_SECRET=
GMAIL_WATCH_TOPIC=
GOOGLE_GMAIL_WATCH_TOPIC=
GOOGLE_WEBHOOK_TOKEN_SECRET=
HUBSPOT_CLIENT_SECRET=
# Must equal the OIDC `audience` configured on the Pub/Sub push subscription.
# Accepts a comma-separated allow-list (e.g. apex + www endpoint URLs) so a host
# change does not 401 every push. A mismatch makes Pub/Sub retry forever.
PUBSUB_GMAIL_WEBHOOK_AUDIENCE=
PUBSUB_GMAIL_WEBHOOK_SERVICE_ACCOUNT_EMAIL=
SLACK_SIGNING_SECRET=
TYPEFORM_WEBHOOK_SECRET=

# Common connector OAuth clients
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
ANTHROPIC_CLIENT_ID=
ANTHROPIC_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
STRIPE_CLIENT_ID=
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=

