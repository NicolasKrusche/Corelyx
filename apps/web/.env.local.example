INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
EXECUTION_PAYLOAD_RETENTION_DAYS=30
EXECUTION_RUN_RETENTION_DAYS=90
RETENTION_AUDIT_RETENTION_DAYS=365

# Public legal identity shown on /impressum
LEGAL_ENTITY_NAME=
LEGAL_REPRESENTATIVE=
LEGAL_ADDRESS_LINE_1=
LEGAL_ADDRESS_LINE_2=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=
LEGAL_EMAIL=legal@corelyx.app
PRIVACY_EMAIL=privacy@corelyx.app
LEGAL_VAT_ID=

# Resend - transactional email for approval notifications
RESEND_API_KEY=
FROM_EMAIL=
# Optional: set to delete contacts from Resend audiences on account deletion
RESEND_AUDIENCE_ID=
# Where DSR / GDPR notifications are routed (defaults to LEGAL_EMAIL above)
LEGAL_NOTIFY_EMAIL=

# DeepL - EU-based translation provider (Cologne, Germany). GDPR-compliant.
# Use the free key (api-free.deepl.com) or set DEEPL_PRO=true for the paid endpoint.
DEEPL_API_KEY=
DEEPL_PRO=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WELCOME_COUPON_ID=
